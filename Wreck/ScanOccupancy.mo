  function yatushColumn
    input Integer i,j,band; output Integer bits;
  algorithm
    if i<8 then bits:=block0x0((i-0)*22+j*1+band+1);
    elseif i<16 then bits:=block0x8((i-8)*22+j*1+band+1);
    elseif i<24 then bits:=block0x16((i-16)*22+j*1+band+1);
    elseif i<32 then bits:=block0x24((i-24)*22+j*1+band+1);
    elseif i<40 then bits:=block0x32((i-32)*22+j*1+band+1);
    elseif i<48 then bits:=block0x40((i-40)*22+j*1+band+1);
    elseif i<56 then bits:=block0x48((i-48)*22+j*1+band+1);
    elseif i<64 then bits:=block0x56((i-56)*22+j*1+band+1);
    elseif i<72 then bits:=block0x64((i-64)*22+j*1+band+1);
    elseif i<80 then bits:=block0x72((i-72)*22+j*1+band+1);
    else bits:=0;end if;
    annotation(Inline=false);
  end yatushColumn;
