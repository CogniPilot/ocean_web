  function satilColumn
    input Integer i,j,band; output Integer bits;
  algorithm
    if i<8 then bits:=block1x0((i-0)*93+j*3+band+1);
    elseif i<16 then bits:=block1x8((i-8)*93+j*3+band+1);
    elseif i<24 then bits:=block1x16((i-16)*93+j*3+band+1);
    elseif i<32 then bits:=block1x24((i-24)*93+j*3+band+1);
    elseif i<40 then bits:=block1x32((i-32)*93+j*3+band+1);
    elseif i<48 then bits:=block1x40((i-40)*93+j*3+band+1);
    elseif i<56 then bits:=block1x48((i-48)*93+j*3+band+1);
    elseif i<64 then bits:=block1x56((i-56)*93+j*3+band+1);
    elseif i<72 then bits:=block1x64((i-64)*93+j*3+band+1);
    elseif i<80 then bits:=block1x72((i-72)*93+j*3+band+1);
    elseif i<88 then bits:=block1x80((i-80)*93+j*3+band+1);
    elseif i<96 then bits:=block1x88((i-88)*93+j*3+band+1);
    elseif i<104 then bits:=block1x96((i-96)*93+j*3+band+1);
    elseif i<112 then bits:=block1x104((i-104)*93+j*3+band+1);
    elseif i<120 then bits:=block1x112((i-112)*93+j*3+band+1);
    elseif i<128 then bits:=block1x120((i-120)*93+j*3+band+1);
    elseif i<136 then bits:=block1x128((i-128)*93+j*3+band+1);
    elseif i<144 then bits:=block1x136((i-136)*93+j*3+band+1);
    elseif i<152 then bits:=block1x144((i-144)*93+j*3+band+1);
    elseif i<160 then bits:=block1x152((i-152)*93+j*3+band+1);
    elseif i<168 then bits:=block1x160((i-160)*93+j*3+band+1);
    elseif i<176 then bits:=block1x168((i-168)*93+j*3+band+1);
    elseif i<184 then bits:=block1x176((i-176)*93+j*3+band+1);
    elseif i<192 then bits:=block1x184((i-184)*93+j*3+band+1);
    else bits:=0;end if;
    annotation(Inline=false);
  end satilColumn;
