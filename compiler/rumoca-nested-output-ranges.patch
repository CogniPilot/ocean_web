+
+#[test]
+fn nested_output_store_ranges_keep_the_original_lane_order() {
+    let mut environment = super::create_environment();
+    environment
+        .add_template("kernel", builtin_template("fmi3", "scalar_kernel.jinja"))
+        .unwrap();
+    environment
+        .add_template(
+            "test.c",
+            "{% from 'kernel' import scalar_op %}{{ scalar_op(op, 'fc_out') }}",
+        )
+        .unwrap();
+    for indices in [vec![3, 4, 5, 6, 7, 8, 9, 10], vec![7, 4, 7, 1, 9, 2, 6, 8]] {
+        let op = serde_json::json!({
+            "kind": "StoreOutputRange", "output_indices": indices, "start": 11, "stride": 2
+        });
+        let c = environment
+            .get_template("test.c")
+            .unwrap()
+            .render(minijinja::context! {op => op})
+            .unwrap();
+        assert!(c.contains("k<8"));
+        assert!(c.contains("r[11+k*2]"));
+        if indices[0] == 3 {
+            assert!(c.contains("fc_out[3+k]"));
+        } else {
+            assert!(c.contains("7,4,7,1,9,2,6,8"));
+            assert!(c.contains("fc_out[dest[k]]"));
+        }
+    }
+}
