+    function tensionOnlyLine "Damped tension in the axis between a moving point and its anchor"
+      input Real lead[3](each unit="m") "Anchor to attachment, world frame";
+      input Real velocity[3](each unit="m/s") "Attachment relative to anchor, world frame";
+      input Real freeLength(unit="m"),stiffness(unit="N/m"),damping(unit="N.s/m");
+      output Real force[3](each unit="N") "Force on the attachment, world frame";
+      output Real tension(unit="N");
+    protected
+      Real distance(unit="m"),axis[3];
+    algorithm
+      distance:=sqrt(lead*lead);
+      axis:=lead/max(.001,distance);
+      tension:=if distance>freeLength then max(0,stiffness*(distance-freeLength)+damping*(velocity*axis)) else 0;
+      force:=-tension*axis;
+    end tensionOnlyLine;
+
   end Forces;
