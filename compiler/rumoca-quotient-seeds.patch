+    let (seeds, input_starts): (Vec<_>, Vec<_>) = event_rows.into_iter()
+        .partition(|&i| is_quotient_seed(problem, i));
+    let (events, event_levels) = dependency_order(calls, programs, &input_starts, &outputs, &y, &mut p).map_err(explain)?;
     order.extend(events);
+    order.extend(seeds);
     Ok((order, levels + event_levels))
 }
 
