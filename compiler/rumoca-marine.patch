+    let source = r#"
+function search
+  input Real x[4];
+  input Real xi;
+  input Integer last;
+  output Real y;
+protected
+  Integer i;
+algorithm
+  i := min(max(last, 1), size(x,1)-1);
+  while i > 1 and xi < x[i] loop
+    i := i - 1;
+  end while;
+  y := x[i];
+end search;
+model Ordered
+  parameter Real u=1;
+  Real y;
+equation
+  y = search({1,2,3,4},u,3);
+end Ordered;
