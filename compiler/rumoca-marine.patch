+  wet := u;
+  force := {u, 2*u, 3*u};
+end loads;
+model Ordered
+  input Real u;
+  Real wet[2], force[2,3];
+equation
+  for i in 1:2 loop
+    (wet[i],force[i,:]) = loads(u+i);
+  end for;
+end Ordered;
+"#;
+    let compiled = compile(source).expect("MLS 12.4.3 permits indexed tuple receivers");
