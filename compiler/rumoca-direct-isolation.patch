+/// For load-only isolators, record where each output comes from. Reading a
+/// scalar directly avoids evaluating every element of a tensor assignment
+/// for each singleton block. Any operation that could fail uses the full kernel.
+fn direct_load_slots(ops: &[solve::LinearOp]) -> Option<Vec<i64>> {
+    use solve::{LinearOp, TensorInputKind};
+    let mut registers = BTreeMap::new();
+    let mut outputs = Vec::new();
+    for op in ops {
+        match *op {
+            LinearOp::LoadY { dst, index } => { registers.insert(dst, index as i64 + 1); }
+            LinearOp::LoadP { dst, index } => { registers.insert(dst, -(index as i64 + 1)); }
+            LinearOp::TensorLoad { dst_start, input, input_start, count, lanes: 1, .. } => {
+                let sign = match input { TensorInputKind::Y => 1, TensorInputKind::P => -1 };
+                for k in 0..count {
+                    registers.insert(dst_start + k as solve::Reg, sign * ((input_start + k) as i64 + 1));
+                }
+            }
+            LinearOp::StoreOutput { src } => outputs.push(*registers.get(&src)?),
+            _ => return None,
+        }
+    }
+    Some(outputs)
+}
