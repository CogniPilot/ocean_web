+/// Cache a compact, assertion-free tuple invocation when projecting its scalar
+/// coordinates. Only the invocation is reused. Surrounding scalar operations
+/// still run, including the choice of which coordinate to write.
+fn tuple_cache(ops: &[solve::LinearOp]) -> Option<Value> {
+    let mut calls = ops.iter().filter_map(|op| match op {
+        solve::LinearOp::PureCall { site, input_starts, .. } => Some((site, input_starts)),
+        _ => None,
+    });
+    let (site, starts) = calls.next()?;
+    if calls.next().is_some()
+        || site.outputs().iter().any(|out| out.kind() == solve::SolvePureCallOutputKind::AssertionPredicate)
+    {
+        return None;
+    }
+    let outputs = site.output_scalar_count()?;
+    let mut inputs = 0usize;
+    let mut spans = Vec::new();
+    for (&start, ty) in starts.iter().zip(site.inputs()) {
+        let count = ty.scalar_count() as usize;
+        spans.push(minijinja::context! { start => start, count => count, offset => inputs });
+        inputs = inputs.checked_add(count)?;
+    }
+    // Bound the per-instance workspace and the cost of exact comparisons.
+    (inputs > 0 && inputs <= 128 && (2..=64).contains(&outputs)).then(|| {
+        minijinja::context! { inputs => inputs, outputs => outputs, spans => spans }
+    })
 }

