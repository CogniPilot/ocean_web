 }
+
+#[test]
+fn repeated_interval_preserves_live_and_chained_history_in_order() {
+    use crate::PreParamBinding;
+    let pairs = [
+        (6, PreParamSource::P { index: 0 }),
+        (7, PreParamSource::P { index: 1 }),
+        (8, PreParamSource::Y { index: 0 }),
+        (9, PreParamSource::P { index: 8 }),
+        (10, PreParamSource::P { index: 2 }),
+        (10, PreParamSource::Y { index: 1 }),
+    ];
+    let layout = SolveLayout {
+        pre_param_bindings: pairs
+            .into_iter()
+            .map(|(dest_p_index, source)| PreParamBinding {
+                dest_p_index,
+                source,
+                clock_schedule: None,
+            })
+            .collect(),
+        ..Default::default()
+    };
+    let runs = layout.history_runs();
+    let reusable: Vec<_> = runs
+        .iter()
+        .filter(|run| run.reusable_between_events)
+        .map(|run| (run.dst, run.count))
+        .collect();
+    assert_eq!(reusable, vec![(6, 2)]);
+    let mut full = [0.; 11];
+    full[..3].copy_from_slice(&[11., 12., 13.]);
+    let mut reused = full;
+    for step in 0..4 {
+        let y = [step as f64, (step + 1) as f64];
+        for run in &runs {
+            for lane in 0..run.count {
+                let src = run.src + lane;
+                let dst = run.dst + lane;
+                full[dst] = if run.from_y { y[src] } else { full[src] };
+                if step == 0 || !run.reusable_between_events {
+                    reused[dst] = if run.from_y { y[src] } else { reused[src] };
+                }
+            }
+        }
+        assert_eq!(reused, full);
+    }
+}
