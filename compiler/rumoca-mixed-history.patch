 }
 
 impl SolveLayout {
     pub(crate) fn history_runs(&self) -> Vec<HistoryRun> {
+        let mut destinations = std::collections::BTreeSet::new();
+        let mut shared_destinations = std::collections::BTreeSet::new();
+        for binding in &self.pre_param_bindings {
+            if !destinations.insert(binding.dest_p_index) {
+                shared_destinations.insert(binding.dest_p_index);
+            }
+        }
         let mut runs: Vec<HistoryRun> = Vec::new();
         for binding in &self.pre_param_bindings {
             let (from_y, src) = match binding.source {
@@ -20,8 +28,13 @@ impl SolveLayout {
             let dst = binding.dest_p_index;
             // An in-place forward copy may read an earlier destination. Split
             // before that dependency so each run observes the ordered scalar semantics.
+            // P sources are stable within the integrator interval unless an
+            // ordered pre() transfer also owns the source or destination.
+            let reusable_between_events =
+                !from_y && !destinations.contains(&src) && !shared_destinations.contains(&dst);
             if let Some(run) = runs.last_mut()
                 && run.from_y == from_y
+                && run.reusable_between_events == reusable_between_events
                 && run.dst.checked_add(run.count) == Some(dst)
                 && run.src.checked_add(run.count) == Some(src)
                 && (from_y || run.dst <= run.src || run.count < run.dst - run.src)
@@ -33,6 +46,7 @@ impl SolveLayout {
                     dst,
                     count: 1,
                     from_y,
+                    reusable_between_events,
