+/// Fixed storage for a large pure function whose values and assertions are
+/// evaluated separately. Every cache hit compares every input bit.
+#[derive(Debug, serde::Serialize)]
+struct RepeatedCall {
+    symbol: u32,
+    widths: Vec<usize>,
+    inputs: usize,
+    outputs: usize,
+    predicates: Vec<usize>,
+}
+
+fn repeated_calls(table: &solve::SolvePureCallTable, symbols: &[u32]) -> Vec<RepeatedCall> {
+    let mut candidates: Vec<_> = table
+        .owners()
+        .iter()
+        .filter_map(|owner| {
+            let symbol = owner.id().index();
+            if symbols[symbol as usize] != symbol {
+                return None;
+            }
+            let widths: Vec<_> = owner
+                .inputs()
+                .iter()
+                .map(|ty| ty.scalar_count() as usize)
+                .collect();
+            let inputs = widths
+                .iter()
+                .copied()
+                .try_fold(0usize, usize::checked_add)?;
+            let mut outputs = 0usize;
+            let mut predicates = Vec::new();
+            for output in owner.outputs() {
+                if output.assertion_level().is_some() {
+                    predicates.push(outputs);
+                }
+                outputs = outputs.checked_add(output.value_type().scalar_count() as usize)?;
+            }
+            // A long computation can be expensive to replay even if it only
+            // returns a few scalars. Bound each cache before budgeting all families.
+            let short_call = outputs < 256 && owner.body().operations().len() < 64;
+            if short_call || inputs.checked_add(outputs)? > 65536 || predicates.is_empty() {
+                return None;
+            }
+            Some(RepeatedCall {
+                symbol,
+                widths,
+                inputs,
+                outputs,
+                predicates,
+            })
+        })
+        .collect();
+    candidates.sort_by_key(|call| std::cmp::Reverse(call.outputs));
+    // Cache high-volume call families independently. The compile-time bound
+    // covers the sum of all input and output arrays in one model instance.
+    let mut remaining = 96 * 1024;
+    candidates.retain(|call| {
+        let width = call.inputs + call.outputs;
+        if width > remaining {
+            return false;
+        }
+        remaining -= width;
+        true
+    });
+    candidates
+}
