@@ -0,0 +1,73 @@
+//! Keep immutable aggregate literals in read-only C storage. This lets LLVM
+//! lower indexed Modelica tables to loads instead of reconstructing every
+//! element on the WASM stack at each lookup.
+use std::collections::BTreeMap;
+
+use serde_json::Value;
+
+pub(super) fn annotate(node: &mut Value) {
+    match node {
+        Value::Object(fields) => {
+            if let Some(operations) = fields.get_mut("operations").and_then(Value::as_array_mut) {
+                annotate_region(operations);
+            }
+            fields.values_mut().for_each(annotate);
+        }
+        Value::Array(items) => items.iter_mut().for_each(annotate),
+        _ => {}
+    }
+}
+
+fn annotate_region(operations: &mut [Value]) {
+    let mut literals = BTreeMap::new();
+    for issued in operations {
+        let op = &mut issued["operation"];
+        match op["operation"].as_str() {
+            Some("constant") if op["value"]["kind"]["kind"] == "integer" => {
+                if let (Some(register), Some(value)) = (
+                    op["destination"].as_u64(),
+                    op["value"]["kind"]["bits"].as_i64(),
+                ) {
+                    literals.insert(register, value);
+                }
+            }
+            Some("construct_aggregate") => {
+                let Some(elements) = op["elements"].as_array() else {
+                    continue;
+                };
+                if elements.len() < 8 {
+                    continue;
+                }
+                let values: Option<Vec<_>> = elements
+                    .iter()
+                    .map(|reg| literals.get(&reg.as_u64()?).copied())
+                    .collect();
+                if let Some(values) = values {
+                    op["integer_literals"] = Value::from(values);
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn annotates_only_complete_integer_literals_in_their_own_region() {
+        let c = json!({"operation":{"operation":"constant","destination":0,"value":{"kind":{"kind":"integer","bits":i64::MIN}}}});
+        let table = json!({"operation":{"operation":"construct_aggregate","destination":1,"elements":[0,0,0,0,0,0,0,0]}});
+        let mixed = json!({"operation":{"operation":"construct_aggregate","destination":2,"elements":[0,0,0,0,0,0,0,3]}});
+        let mut program = json!({"operations":[c,table,mixed],"body":{"operations":[table]}});
+        annotate(&mut program);
+        assert_eq!(
+            program["operations"][1]["operation"]["integer_literals"],
+            json!(vec![i64::MIN; 8])
+        );
+        assert!(program["operations"][2]["operation"]["integer_literals"].is_null());
+        assert!(program["body"]["operations"][0]["operation"]["integer_literals"].is_null());
+    }
+}
