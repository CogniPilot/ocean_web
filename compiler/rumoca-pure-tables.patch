+use super::assertion_carrier::compile_and_execute;
+
+/// Exercise cache misses, the exact predicate layout, bitwise argument
+/// identity, independent instances and warning/error replay in emitted C.
+#[test]
+fn repeated_call_reuses_only_effect_free_success_for_identical_inputs() {
+    let mut environment = super::super::super::create_environment();
+    environment.add_template("repeated_call_control", r#"
+{%- from "fmi-typed-functions.jinja" import repeated_call_fields, repeated_call_kernel %}
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <math.h>
+typedef struct { {{ repeated_call_fields(memos) }} } ModelInstance;
+typedef struct { void* context; int (*observe)(void*, size_t, const void* const[], size_t); } RmcAssertionObserver;
+static int calls, checks, notices;
+static int receive(void* context,size_t predicate,const void* const captures[],size_t n){
+    (void)context;(void)predicate;(void)captures;(void)n;++notices;return 0;
+}
+static int rumoca_scalar_pure_9(const double* const in[],double* out,const RmcAssertionObserver* o){
+    ++calls;
+    if(in[1][0]<0){o->observe(o->context,0,NULL,0);if(in[1][0]<-1)return 2;}
+    out[0]=in[0][0];out[1]=in[1][0]<0?0:1;out[2]=in[0][1];return 0;
+}
+static int rumoca_scalar_observe_9(const double* const in[],double* out,const RmcAssertionObserver* o){
+    ++checks;double all[3];int status=rumoca_scalar_pure_9(in,all,o);if(!status)*out=all[1];return status;
+}
+static int other_calls;
+static int rumoca_scalar_pure_10(const double* const in[],double* out,const RmcAssertionObserver* o){
+    (void)o;++other_calls;out[0]=in[0][0]+7;out[1]=1;out[2]=0;return 0;
+}
+static int rumoca_scalar_observe_10(const double* const in[],double* out,const RmcAssertionObserver* o){
+    (void)in;(void)o;out[0]=1;return 0;
+}
+{{ repeated_call_kernel(memos) }}
+int main(void){
+    ModelInstance a={0},b={0};double x[]={0,2},flag=1,out[3]={0};const double* in[]={x,&flag};
+    const RmcAssertionObserver log={NULL,receive};
+    assert(!rmc_repeated_pure_call_9(&a,false,in,out,&log));
+    assert(!rmc_repeated_pure_call_9(&a,true,in,out,&log)&&out[0]==1);
+    assert(!rmc_repeated_pure_call_9(&a,false,in,out,&log)&&out[0]==0&&out[2]==2);
+    assert(!rmc_repeated_pure_call_10(&a,false,in,out,&log)&&other_calls==1&&out[0]==7);
+    assert(!rmc_repeated_pure_call_9(&a,false,in,out,&log)&&out[0]==0);
+    assert(!rmc_repeated_pure_call_10(&a,false,in,out,&log)&&other_calls==1&&out[0]==7);
+    assert(calls==1&&checks==0);
+    assert(!rmc_repeated_pure_call_9(&b,true,in,out,&log)&&calls==2&&checks==1);
+    x[0]=-0.0;
+    assert(!rmc_repeated_pure_call_9(&a,false,in,out,&log)&&signbit(out[0])&&calls==3);
+    flag=-1;
+    assert(!rmc_repeated_pure_call_9(&a,false,in,out,&log)&&notices==1);
+    assert(!rmc_repeated_pure_call_9(&a,true,in,out,&log)&&notices==2&&out[0]==0);
+    flag=-2;
+    assert(rmc_repeated_pure_call_9(&a,false,in,out,&log)==2&&notices==3);
+    assert(rmc_repeated_pure_call_9(&a,true,in,out,&log)==2&&notices==4);
+    return 0;
+}"#).unwrap();
+    let memo =
+        serde_json::json!({"symbol":9,"widths":[2,1],"inputs":3,"outputs":3,"predicates":[1]});
+    let mut other = memo.clone();
+    other["symbol"] = serde_json::json!(10);
+    let memos = [memo, other];
+    let source = environment
+        .get_template("repeated_call_control")
+        .unwrap()
+        .render(minijinja::context! { memos })
+        .unwrap();
+    compile_and_execute(&source);
+}
