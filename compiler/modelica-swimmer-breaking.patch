+  function breakingRow
+    input Real before[n],here[n],after[n],velocity[n],foam[n],cell,dt;
+    output Real row[3,n];
+  protected
+    constant Real criticalSlope=.58;
+    Real difference[4],spill[4],rate,diffusion;
+  algorithm
+    row:={here,velocity,foam*exp(-.91*dt)};
+    diffusion:=min(.20,2*dt);
+    for i in 2:n-1 loop
+      difference:={here[i-1]-here[i],here[i+1]-here[i],before[i]-here[i],after[i]-here[i]};
+      spill:={max(0,difference[k]-criticalSlope*cell)+min(0,difference[k]+criticalSlope*cell) for k in 1:4};
+      // A steep face spills into its lower neighbour. Opposite fluxes
+      // conserve surface volume away from the open boundary.
+      rate:=max(abs(spill))/cell;
+      if rate>0 then
+        row[1,i]:=here[i]+diffusion*sum(spill);
+        row[2,i]:=velocity[i]/(1+18*dt*rate);
+        row[3,i]:=1-(1-row[3,i])*exp(-4*dt*rate);
+      end if;
+    end for;
+  end breakingRow;
