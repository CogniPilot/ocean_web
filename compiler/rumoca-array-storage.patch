@@ -0,0 +1,189 @@
+//! Borrow contiguous parameter inputs to a pure call across a run of loads.
+//! Other operations keep their original register and snapshot semantics.
+
+use crate::linear_op::op_read_register_ranges;
+use crate::{LinearOp, Reg, ScalarProgramBlock, TensorInputKind};
+
+impl ScalarProgramBlock {
+    /// Entries are parameter-buffer offsets for arguments whose entire register
+    /// span still contains the corresponding contiguous parameter snapshot.
+    #[must_use]
+    pub fn pure_call_parameter_inputs(
+        &self,
+        program: usize,
+        operation: usize,
+    ) -> Option<Vec<Option<usize>>> {
+        let row = self.programs().get(program)?;
+        let LinearOp::PureCall {
+            input_starts, site, ..
+        } = row.get(operation)?
+        else {
+            return None;
+        };
+        Some(
+            input_starts
+                .iter()
+                .zip(site.inputs())
+                .map(|(&start, ty)| parameter_source(&row[..operation], start, ty.scalar_count()))
+                .collect(),
+        )
+    }
+    /// A parameter snapshot can be omitted when its first consumer borrows all
+    /// overlapping inputs and the rest of the row never reads the snapshot.
+    #[must_use]
+    pub fn is_borrowed_parameter_load(&self, program: usize, operation: usize) -> bool {
+        let Some(row) = self.programs().get(program) else {
+            return false;
+        };
+        let Some(LinearOp::TensorLoad {
+            dst_start,
+            count,
+            input: TensorInputKind::P,
+            lanes: 1,
+            seed_start: None,
+            ..
+        }) = row.get(operation)
+        else {
+            return false;
+        };
+        if *count <= 1 {
+            return false;
+        }
+        let start = *dst_start as usize;
+        let Some(end) = start.checked_add(*count) else {
+            return false;
+        };
+        for (index, op) in row.iter().enumerate().skip(operation + 1) {
+            match op {
+                LinearOp::LoadY { .. }
+                | LinearOp::LoadP { .. }
+                | LinearOp::LoadTime { .. }
+                | LinearOp::Const { .. }
+                | LinearOp::TensorLoad { .. } => continue,
+                LinearOp::PureCall {
+                    site, input_starts, ..
+                } => {
+                    let mut borrowed = false;
+                    for (&reg, ty) in input_starts.iter().zip(site.inputs()) {
+                        let width = ty.scalar_count();
+                        let first = reg as usize;
+                        if first < end && first.saturating_add(width as usize) > start {
+                            if parameter_source(&row[..index], reg, width).is_none() {
+                                return false;
+                            }
+                            borrowed = true;
+                        }
+                    }
+                    return borrowed
+                        && row[index + 1..]
+                            .iter()
+                            .all(|op| avoids_span(op, start, end));
+                }
+                _ => return false,
+            }
+        }
+        false
+    }
+}
+
+// A strided read is conservatively bounded by its first and last register.
+fn avoids_span(op: &LinearOp, start: usize, end: usize) -> bool {
+    op_read_register_ranges(op).is_some_and(|reads| {
+        reads.iter().all(|read| {
+            let first = read.start as usize;
+            let last =
+                first.saturating_add(read.count.saturating_sub(1).saturating_mul(read.stride));
+            read.count == 0 || first >= end || last < start
+        })
+    })
+}
+
+fn parameter_source(prior: &[LinearOp], start: Reg, width: u32) -> Option<usize> {
+    if width <= 1 {
+        return None;
+    }
+    let end = start.checked_add(width)?;
+    for op in prior.iter().rev() {
+        match op {
+            LinearOp::LoadP { dst, .. }
+            | LinearOp::LoadY { dst, .. }
+            | LinearOp::Const { dst, .. }
+            | LinearOp::LoadTime { dst }
+                if !(start..end).contains(dst) => {}
+            LinearOp::TensorLoad {
+                dst_start,
+                input,
+                input_start,
+                count,
+                lanes: 1,
+                seed_start: None,
+            } => {
+                let limit = dst_start.checked_add(u32::try_from(*count).ok()?)?;
+                if *dst_start >= end || limit <= start {
+                    continue;
+                }
+                if *input == TensorInputKind::P && *dst_start <= start && end <= limit {
+                    return input_start.checked_add((start - dst_start) as usize);
+                }
+                return None;
+            }
+            _ => return None,
+        }
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn load() -> LinearOp {
+        LinearOp::TensorLoad {
+            dst_start: 3,
+            input: TensorInputKind::P,
+            input_start: 42,
+            count: 12,
+            lanes: 1,
+            seed_start: None,
+        }
+    }
+
+    #[test]
+    fn later_scalar_and_strided_reads_preserve_the_snapshot() {
+        assert!(!avoids_span(&LinearOp::StoreOutput { src: 4 }, 3, 15));
+        assert!(!avoids_span(
+            &LinearOp::StoreOutputRange {
+                start: 0,
+                count: 3,
+                stride: 6
+            },
+            3,
+            15
+        ));
+        assert!(avoids_span(
+            &LinearOp::StoreOutputRange {
+                start: 15,
+                count: 3,
+                stride: 1
+            },
+            3,
+            15
+        ));
+    }
+
+    #[test]
+    fn intact_subranges_can_borrow_the_parameter_storage() {
+        let ops = [load(), LinearOp::LoadY { dst: 20, index: 0 }];
+        assert_eq!(parameter_source(&ops, 4, 9), Some(43));
+        assert_eq!(parameter_source(&ops, 4, 12), None);
+    }
+
+    #[test]
+    fn overwritten_lanes_and_possible_effects_keep_the_snapshot() {
+        let overwritten = [load(), LinearOp::LoadY { dst: 9, index: 2 }];
+        assert_eq!(parameter_source(&overwritten, 4, 9), None);
+        assert_eq!(parameter_source(&overwritten, 10, 3), Some(49));
+        let boundary = [load(), LinearOp::StoreOutput { src: 4 }];
+        assert_eq!(parameter_source(&boundary, 3, 12), None);
+    }
+}
