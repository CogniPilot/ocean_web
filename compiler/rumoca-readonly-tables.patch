+        let make_table = |id| json!({"operation":{"operation":"construct_aggregate","destination":id,"elements":[0,0,0,0,0,0,0,0]}});
+        let c = json!({"operation":{"operation":"constant","destination":0,"value":{"kind":{"kind":"integer","bits":-17}}}});
+        let mut program = json!({"storage":{"aliases":{"homes":homes}},"operations":[c, make_table(1), make_table(2), make_table(4)]});
+        annotate(&mut program);
