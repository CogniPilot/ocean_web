+function connectOcean(port: MessagePort): void {
+  disconnect(false);
+  oceanPort = port;
+  vehicleId = 'ocean-rdd2';
+  state = createInitialVehicleState(vehicleId);
+  resetPlotState();
+  startStaleTimer();
+  let frameSequence = 0;
+  let missionId = 0;
+  let lastRoute = '';
+  port.onmessage = ({ data }: MessageEvent<unknown>) => {
+    if (oceanPort !== port || !data || typeof data !== 'object') return;
+    const message = data as Record<string, unknown>;
+    if (message.type === 'commandResult') {
+      if (pendingOceanCommand && message.id === pendingOceanCommand.id &&
+        typeof message.ok === 'boolean' && typeof message.message === 'string') {
+        finishOceanCommand(message.message, message.ok);
+      }
+      return;
+    }
+    if (message.type !== 'telemetry' || typeof message.time !== 'number' ||
+      !Number.isFinite(message.time) || message.time < 0 ||
+      !isOceanEnu(message.position) || !isOceanEnu(message.velocity) || !isOceanEnu(message.attitude) ||
+      typeof message.armed !== 'boolean' || !message.mission || typeof message.mission !== 'object') {
+      return;
+    }
+    const route = message.mission as Record<string, unknown>;
+    if (!Array.isArray(route.waypoints) || route.waypoints.length > 7 ||
+      !Array.from(route.waypoints).every(isOceanEnu)) return;
+    const waypoints = route.waypoints as OceanEnu[];
+    const missionState = route.state === 'active' || route.state === 'complete' ? route.state :
+      route.state === 'paused' || route.state === 'holding' ? 'paused' : 'idle';
+    const sequence = typeof route.sequence === 'number' && Number.isInteger(route.sequence) ?
+      Math.max(0, Math.min(waypoints.length - 1, route.sequence)) : 0;
+    const routeKey = JSON.stringify(waypoints);
+    const publishWaypoints = routeKey !== lastRoute;
+    if (publishWaypoints) {
+      lastRoute = routeKey;
+      missionId++;
+      if (waypoints.length === 0) state.mission = null;
+    }
+    oceanLastTelemetry = performance.now();
+    const now = Date.now();
+    const snapshot: OceanRdd2Telemetry = {
+      type: 'telemetry', time: message.time, position: message.position, velocity: message.velocity,
+      attitude: message.attitude, armed: message.armed, mission: { state: missionState, sequence, waypoints }
+    };
+    applyFrames(oceanTelemetryFrames(snapshot, {
+      sequence: ++frameSequence, sourceTimeNs: snapshot.time * 1e9,
+      receiveTimeNs: now * 1e6, expireTimeNs: 0, vehicleId, schemaVersion: 1,
+      messageType: '', priority: 'normal', streamId: 'ocean-rdd2'
+    }, missionId, publishWaypoints));
+  };
+  port.start();
+  postState();
+}
+
+function finishOceanCommand(message: string, ok: boolean): void {
+  if (pendingOceanCommand) clearTimeout(pendingOceanCommand.timer);
+  pendingOceanCommand = null;
+  ctx.postMessage({ type: 'oceanCommandStatus', pending: false, ok, message: message.slice(0, 200) });
+}
+
+function sendOceanCommand(command: OceanRdd2Command, waypoints: OceanEnu[] = []): void {
+  if (!oceanPort || performance.now() - oceanLastTelemetry > 2400) {
+    finishOceanCommand('Waiting for live Ocean Web telemetry.', false);
+    return;
+  }
+  if (pendingOceanCommand) return;
+  const id = ++oceanCommandId;
+  let message;
+  try {
+    message = command === 'upload'
+      ? { type: 'command', id, command, waypoints: oceanWaypointPacket(waypoints, id) }
+      : { type: 'command', id, command };
+  } catch (error) {
+    finishOceanCommand(error instanceof Error ? error.message : 'Invalid trajectory.', false);
+    return;
+  }
+  oceanPort.postMessage(message);
+  pendingOceanCommand = {
+    id, timer: setTimeout(() => finishOceanCommand('Ocean Web did not acknowledge the command.', false), 3500)
+  };
+  ctx.postMessage({ type: 'oceanCommandStatus', pending: true, ok: true, message: 'Waiting for Ocean Web…' });
+}
+
 function disconnect(post = true): void {
+  oceanPort?.close();
+  oceanPort = null;
+  oceanLastTelemetry = -Infinity;
+  if (pendingOceanCommand) clearTimeout(pendingOceanCommand.timer);
+  pendingOceanCommand = null;
   stopVirtualManualTimer();
   if (runtimeRefreshTimer !== null) clearTimeout(runtimeRefreshTimer);
   runtimeRefreshTimer = null;
