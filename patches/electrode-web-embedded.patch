@@ -0,0 +1,40 @@
+import { describe, expect, it } from 'vitest';
+
+import { oceanTelemetryFrames, oceanWaypointPacket, type OceanRdd2Telemetry } from './ocean-rdd2';
+import { applyGcsFrame, createInitialVehicleState } from './state-store';
+import type { MessageHeader } from './types';
+
+describe('Ocean Web RDD2 FlatBuffers', () => {
+  it('recovers a single target and all cubic segment endpoints without spurious points', () => {
+    expect(oceanWaypointPacket([[3, -4, 8]], 1)).toEqual([[3, -4, 8]]);
+    expect(oceanWaypointPacket([[3, -4, 8], [7, 2, 10], [8, 2, 6]], 2))
+      .toEqual([[3, -4, 8], [7, 2, 10], [8, 2, 6]]);
+    expect(() => oceanWaypointPacket([[3, -4, Infinity]], 3)).toThrow(/finite/);
+  });
+
+  it('applies the wire topics to the live map, health, route and target', () => {
+    const now = Date.now();
+    const header: MessageHeader = {
+      sequence: 1, schemaVersion: 1, priority: 'normal', vehicleId: 'ocean-rdd2',
+      messageType: '', streamId: 'ocean-rdd2', receiveTimeNs: now * 1e6, sourceTimeNs: 3e9, expireTimeNs: 0
+    };
+    const sample: OceanRdd2Telemetry = {
+      type: 'telemetry', time: 3, position: [-32, -8, 5], attitude: [0, 0, Math.PI / 2],
+      velocity: [3, 4, 1], armed: true,
+      mission: { state: 'active', sequence: 1, waypoints: [[-32, -8, 5], [-22, -8, 7]] }
+    };
+    let state = createInitialVehicleState(header.vehicleId);
+    for (const frame of oceanTelemetryFrames(sample, header, 5, true)) {
+      state = applyGcsFrame(state, frame, now);
+    }
+    expect(state.connected).toBe(true);
+    expect(state.pose).toMatchObject({ xM: -32, yM: -8, altM: 5 });
+    expect(state.velocity).toMatchObject({ eastMps: 3, northMps: 4, downMps: -1, groundSpeedMps: 5 });
+    expect(state.mode).toMatchObject({ name: 'auto', armed: true });
+    expect(state.mission).toMatchObject({
+      missionId: 5, state: 'active', currentSeq: 1, total: 2,
+      target: { east: -22, north: -8, up: 7 },
+      waypoints: [{ east: -32, north: -8, up: 5 }, { east: -22, north: -8, up: 7 }]
+    });
+  });
+});
